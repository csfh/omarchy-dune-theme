# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0D0C0B"

# Main text color
theme[main_fg]="#E8E0D4"

# Title color for boxes
theme[title]="#E8E0D4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#D6A63C"

# Background color of selected item in processes box
theme[selected_bg]="#D6A63C"

# Foreground color of selected item in processes box
theme[selected_fg]="#D6A63C"

# Color of inactive/disabled text
theme[inactive_fg]="#8A8278"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#F2ECE2"

# Background color of the percentage meters
theme[meter_bg]="#D6A63C"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#F2ECE2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#D6457A"
theme[mem_box]="#6B9A4A"
theme[net_box]="#C45C3A"
theme[proc_box]="#D6A63C"

# Box divider line and small boxes line color
theme[div_line]="#8A8278"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#6B9A4A"
theme[temp_mid]="#D6A63C"
theme[temp_end]="#C45C3A"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#3DB8B0"
theme[cpu_mid]="#4A86C4"
theme[cpu_end]="#D6457A"

# Mem/Disk free meter
theme[free_start]="#D6457A"
theme[free_mid]="#4A86C4"
theme[free_end]="#3DB8B0"

# Mem/Disk cached meter
theme[cached_start]="#4A86C4"
theme[cached_mid]="#3DB8B0"
theme[cached_end]="#D6457A"

# Mem/Disk available meter
theme[available_start]="#D6A63C"
theme[available_mid]="#C45C3A"
theme[available_end]="#C45C3A"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#6B9A4A"
theme[used_mid]="#3DB8B0"
theme[used_end]="#4A86C4"

# Download graph colors
theme[download_start]="#D6A63C"
theme[download_mid]="#C45C3A"
theme[download_end]="#C45C3A"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#6B9A4A"
theme[upload_mid]="#3DB8B0"
theme[upload_end]="#4A86C4"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#3DB8B0"
theme[process_mid]="#4A86C4"
theme[process_end]="#D6457A"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#0D0C0B"
theme[gradient_color_1]="#24211E"
theme[gradient_color_2]="#D6A63C"
theme[gradient_color_3]="#8A8278"
theme[gradient_color_4]="#B8AFA3"
theme[gradient_color_5]="#E8E0D4"
theme[gradient_color_6]="#F2ECE2"
theme[gradient_color_7]="#FFF8EC"
